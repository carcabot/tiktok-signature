# TikTok Signature Server Configuration
# Copy this file to .env and fill in your values

# Server port (default: 8080)
PORT=8080

# Proxy Configuration (optional)
# Multiple proxies: each browser identity is pinned to one of them.
# Accepted: host:port, host:port:user:pass, user:pass@host:port, http://user:pass@host:port
#PROXY_LIST=http://user:pass@1.2.3.4:8080,5.6.7.8:3128:user:pass
# ...or a file: .txt (one proxy per line, # comments) or .json (array of strings/objects)
#PROXY_FILE=./proxies.txt
# Identities pinned to each proxy (default: 1). Pool size defaults to proxies x this.
#IDENTITIES_PER_PROXY=1
# How long a failing proxy is benched, ms (default: 300000 = 5 min, 0 = never)
#PROXY_PENALTY_MS=300000
# Return the proxy URL WITH credentials in /signature (default: false = masked).
# /signature is unauthenticated: enable only on a server untrusted clients can't reach.
#EXPOSE_PROXY_IN_SIGNATURE=false

# Single proxy (legacy). Set PROXY_ENABLED=true to use it.
PROXY_ENABLED=false
PROXY_HOST=proxy.example.com:8080
PROXY_USER=your_username
PROXY_PASS=your_password

# Chrome executable path (optional, auto-detected by default)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Auto-refresh tuning (optional)
# Restart browser after this many signatures (default: 500)
#MAX_GENERATIONS_BEFORE_REFRESH=500
# Restart browser after this many ms of session age (default: 1800000 = 30 min)
#MAX_SESSION_AGE_MS=1800000
# Identity pool (optional)
# Browser identities kept warm; requests rotate through them
# (default: 3; with PROXY_LIST / PROXY_FILE: proxies x IDENTITIES_PER_PROXY)
#IDENTITY_POOL_SIZE=3
# Ignore POST /report for identities younger than this many ms (default: 15000)
#REPORT_MIN_AGE_MS=15000
# Minimum gap between report-driven retirements, ms (default: 20000)
#REPORT_RETIRE_COOLDOWN_MS=20000
